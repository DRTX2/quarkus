# PERFIL DE QUARKUS
QUARKUS_PROFILE=dev

# APLICACIÓN
APP_NAME=learning-quarkus
APP_ENV=development

# SERVIDOR
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# BASE DE DATOS - PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quarkus_dev_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# CORS (Permisivo en desarrollo)
CORS_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173,http://localhost:8080

# SEGURIDAD - JWT
JWT_ENABLED=true
JWT_ISSUER=https://learning-quarkus-dev
JWT_DURATION=3600
JWT_REFRESH_DURATION=604800
JWT_REFRESH_MAX_PER_USER=5

# SEGURIDAD - Protección Brute Force
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOCK_DURATION=900

# EMAIL (Mock en desarrollo)
MAIL_FROM=noreply@localhost
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_MOCK=true

# LOGGING
LOG_LEVEL=DEBUG
LOG_JSON_ENABLED=false

# OBSERVABILIDAD
HEALTH_ENABLED=true
METRICS_ENABLED=true
TRACING_ENABLED=false

# OIDC (Deshabilitado en dev)
OIDC_ENABLED=false