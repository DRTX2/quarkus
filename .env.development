# Configuración para entorno de desarrollo local
TRACING_ENABLED=false
HEALTH_ENABLED=true
METRICS_ENABLED=true
# Métricas y observabilidad

OIDC_ENABLED=false
# OIDC - Deshabilitado en desarrollo

JWT_DURATION=3600
JWT_ISSUER=http://localhost:8080
JWT_SECRET=dev-secret-key-change-in-production
# Security - NO usar en producción

LOG_JSON_ENABLED=false
LOG_LEVEL=DEBUG
# Logging - Más verbose en desarrollo

MAIL_MOCK=true
MAIL_PORT=1025
MAIL_HOST=localhost
MAIL_FROM=dev@localhost
# Email - Modo mock para desarrollo

CORS_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173
# CORS - Permitir frontend local

DB_POOL_MAX_SIZE=10
DB_POOL_MIN_SIZE=5
DB_PASSWORD=postgres
DB_USER=postgres
DB_NAME=quarkus_dev
DB_PORT=5432
DB_HOST=localhost
# Base de Datos - Desarrollo

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# Servidor

APP_NAME=learning-quarkus
APP_ENV=development

