# Configuración para tests
APP_ENV=test

# Servidor
SERVER_PORT=8081
SERVER_HOST=localhost

# Base de Datos - H2 en memoria para tests
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quarkus_test
DB_USER=test
DB_PASSWORD=test

# Email - Siempre mock en tests
MAIL_MOCK=true

# Logging
LOG_LEVEL=WARN
LOG_JSON_ENABLED=false

# Security - Valores de prueba
JWT_SECRET=test-secret-key-for-testing-only
JWT_ISSUER=http://localhost:8081
JWT_DURATION=300

