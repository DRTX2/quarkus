# ⚠️ En producción, usa variables de entorno del sistema o secrets manager
# PERFIL DE QUARKUS
QUARKUS_PROFILE=prod

# APLICACIÓN
APP_NAME=learning-quarkus
APP_ENV=production

# SERVIDOR
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# BASE DE DATOS - PostgreSQL
# ⚠️ CAMBIAR ESTOS VALORES EN PRODUCCIÓN
DB_HOST=your-production-db-host.com
DB_PORT=5432
DB_NAME=quarkus_prod_db
DB_USER=prod_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_IN_PRODUCTION
DB_POOL_MIN_SIZE=10
DB_POOL_MAX_SIZE=50

# CORS (Restrictivo en producción)
# ⚠️ ESPECIFICAR SOLO DOMINIOS PERMITIDOS
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# SEGURIDAD - JWT
# ⚠️ CAMBIAR ISSUER Y DURACIONES EN PRODUCCIÓN
JWT_ENABLED=true
JWT_ISSUER=https://api.yourdomain.com
JWT_DURATION=1800
JWT_REFRESH_DURATION=604800
JWT_REFRESH_MAX_PER_USER=3

# SEGURIDAD - Protección Brute Force
SECURITY_MAX_LOGIN_ATTEMPTS=3
SECURITY_LOCK_DURATION=1800

# EMAIL (Servicio real en producción)
# ⚠️ CONFIGURAR SMTP REAL
MAIL_FROM=noreply@yourdomain.com
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=CHANGE_THIS_SENDGRID_API_KEY
MAIL_MOCK=false

# LOGGING
LOG_LEVEL=WARN
LOG_JSON_ENABLED=true

# OBSERVABILIDAD
HEALTH_ENABLED=true
METRICS_ENABLED=true
TRACING_ENABLED=true

# OIDC (Opcional - para SSO)
OIDC_ENABLED=false
# OIDC_AUTH_SERVER_URL=https://auth.yourdomain.com/realms/production
# OIDC_CLIENT_ID=backend-service
# OIDC_CLIENT_SECRET=CHANGE_THIS_SECRET