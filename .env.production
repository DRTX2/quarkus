# Configuración para entorno de producción
# IMPORTANTE: Este archivo es solo un template
# En producción, usa variables de entorno del sistema o secrets manager

APP_ENV=production
APP_NAME=learning-quarkus

# Servidor
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Base de Datos - Usar variables del sistema en producción
DB_HOST=${DATABASE_HOST}
DB_PORT=${DATABASE_PORT}
DB_NAME=${DATABASE_NAME}
DB_USER=${DATABASE_USER}
DB_PASSWORD=${DATABASE_PASSWORD}
DB_POOL_MIN_SIZE=10
DB_POOL_MAX_SIZE=50

# CORS - Especificar dominios permitidos
CORS_ORIGINS=${ALLOWED_ORIGINS}

# Email - Configuración real
MAIL_FROM=${MAIL_FROM_ADDRESS}
MAIL_HOST=${MAIL_SERVER_HOST}
MAIL_PORT=${MAIL_SERVER_PORT}
MAIL_USERNAME=${MAIL_SERVER_USERNAME}
MAIL_PASSWORD=${MAIL_SERVER_PASSWORD}
MAIL_MOCK=false

# Logging
LOG_LEVEL=INFO
LOG_JSON_ENABLED=true

# Security - USAR SECRETS MANAGER
JWT_SECRET=${JWT_SECRET_KEY}
JWT_ISSUER=${JWT_ISSUER_URL}
JWT_DURATION=1800

# OIDC
OIDC_ENABLED=${OIDC_ENABLED:true}
OIDC_AUTH_SERVER_URL=${OIDC_AUTH_SERVER_URL}
OIDC_CLIENT_ID=${OIDC_CLIENT_ID}
OIDC_CLIENT_SECRET=${OIDC_CLIENT_SECRET}

# Kafka (si se usa)
KAFKA_BOOTSTRAP_SERVERS=${KAFKA_SERVERS}

# Métricas y observabilidad
METRICS_ENABLED=true
HEALTH_ENABLED=true
TRACING_ENABLED=true

