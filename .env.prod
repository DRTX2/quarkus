# PERFIL DE QUARKUS
QUARKUS_PROFILE=prod

# APLICACIÓN
APP_ENV=production
APP_NAME=learning-quarkus

# SERVIDOR
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# BASE DE DATOS
# ⚠️ Usar valores del sistema en producción
# ============================================================================
DB_HOST=${DATABASE_HOST:-db.production.example.com}
DB_PORT=${DATABASE_PORT:-5432}
DB_NAME=${DATABASE_NAME:-quarkus_prod}
DB_USER=${DATABASE_USER:-quarkus_user}
DB_PASSWORD=${DATABASE_PASSWORD}
DB_POOL_MIN_SIZE=10
DB_POOL_MAX_SIZE=50

# ============================================================================
# CORS
# ⚠️ Especificar dominios permitidos
# ============================================================================
CORS_ORIGINS=${ALLOWED_ORIGINS:-https://app.example.com,https://www.example.com}

# ============================================================================
# EMAIL
# ⚠️ Configurar SMTP real
# ============================================================================
MAIL_FROM=${MAIL_FROM_ADDRESS:-noreply@example.com}
MAIL_HOST=${MAIL_SERVER_HOST:-smtp.sendgrid.net}
MAIL_PORT=${MAIL_SERVER_PORT:-587}
MAIL_USERNAME=${MAIL_SERVER_USERNAME}
MAIL_PASSWORD=${MAIL_SERVER_PASSWORD}
MAIL_MOCK=false

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_JSON_ENABLED=true

# ============================================================================
# SECURITY - JWT
# ⚠️ CRÍTICO: Usar secret manager en producción
# ============================================================================
JWT_ENABLED=true
JWT_SECRET=${JWT_SECRET_KEY}
JWT_ISSUER=${JWT_ISSUER_URL:-https://api.example.com}
JWT_DURATION=1800

# ============================================================================
# OIDC
# ============================================================================
OIDC_ENABLED=${OIDC_ENABLED:-false}
OIDC_AUTH_SERVER_URL=${OIDC_AUTH_SERVER_URL}
OIDC_CLIENT_ID=${OIDC_CLIENT_ID}
OIDC_CLIENT_SECRET=${OIDC_CLIENT_SECRET}

# ============================================================================
# OBSERVABILIDAD
# ============================================================================
HEALTH_ENABLED=true
METRICS_ENABLED=true
TRACING_ENABLED=true

# ============================================================================
# KAFKA (Si se usa)
# ============================================================================
# KAFKA_BOOTSTRAP_SERVERS=${KAFKA_SERVERS:-kafka.production.example.com:9092}

